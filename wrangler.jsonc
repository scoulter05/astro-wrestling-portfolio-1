{
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "astro-wrestling-portfolio-1",
	"compatibility_date": "2026-06-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "workers-site/index.js",
	"type": "javascript",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"env": {
		"production": {
			"routes": [
				{
					"pattern": "astro-wrestling-portfolio-1.siddonfilm.workers.dev/*",
					"zone_name": "siddonfilm.workers.dev"
				}
			]
		}
	}
}
