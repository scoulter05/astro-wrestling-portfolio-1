{
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "astro-wrestling-portfolio-1",
	"compatibility_date": "2026-06-02",
	"main": "dist/_worker.js",
	"build": {
		"command": "npm run build"
	},
	"env": {
		"production": {
			"routes": [
				{
					"pattern": "astro-wrestling-portfolio-1.siddonfilm.workers.dev/*",
					"zone_name": "siddonfilm.workers.dev"
				}
			]
		}
	},
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "dist"
	},
	"site": {
		"bucket": "dist"
	}
}
